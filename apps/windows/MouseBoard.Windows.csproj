<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MouseBoard</AssemblyName>
    <RootNamespace>MouseBoard.Windows</RootNamespace>
    <Product>MouseBoard</Product>
    <Title>MouseBoard</Title>
    <Description>Bluetooth setup companion for the MouseBoard phone controller.</Description>
    <Version>0.5.1</Version>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>None</DebugType>
    <ApplicationIcon>Assets/MouseBoard.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <InstallerApk Condition="'$(InstallerApk)' == ''">$(MSBuildThisFileDirectory)../../dist/MouseBoard-Android.apk</InstallerApk>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Resource Include="Assets/MouseBoard.ico" />
    <EmbeddedResource Include="$(InstallerApk)" Condition="Exists('$(InstallerApk)')">
      <LogicalName>MouseBoard.Android.apk</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <Target Name="RequirePhoneInstaller" BeforeTargets="PrepareForPublish"
          Condition="!Exists('$(InstallerApk)')">
    <Error Text="Build the Android app first. Missing $(InstallerApk)" />
  </Target>
</Project>
